    {
      "id": "line-buffer",
      "task": "Fix LineBuffer in lines.py for strings arriving in arbitrary chunks. feed(part) emits every complete LF-delimited line, including empty lines; strip one CR immediately before LF. Keep partial text across calls. finish() emits the remaining nonempty text unchanged once, then returns [] on later calls.",
      "files": {
        "lines.py": "class LineBuffer:\n    def __init__(self): self.pending = ''\n    def feed(self, part):\n        self.pending += part\n        rows = self.pending.splitlines()\n        self.pending = ''\n        return rows\n    def finish(self): return []\n",
        "test_lines.py": "import unittest\nfrom lines import LineBuffer\nclass Tests(unittest.TestCase):\n    def test_partial(self):\n        b=LineBuffer(); self.assertEqual(b.feed('ab'),[]); self.assertEqual(b.feed('c\\n'),['abc'])\n",
        "AGENTS.md": "Use the standard library and existing style. Do not change existing tests or notes.txt. Do not install packages or use the network.\n",
        "notes.txt": "Unrelated user work in progress: preserve this exact text.\n",
        "README.md": "Standalone exercise. Run checks with: python3 -m unittest -v\n"
      },
      "reference": {
        "lines.py": "class LineBuffer:\n    def __init__(self): self.pending = ''\n    def feed(self, part):\n        self.pending += part\n        rows = self.pending.split('\\n')\n        self.pending = rows.pop()\n        return [row[:-1] if row.endswith('\\r') else row for row in rows]\n    def finish(self):\n        rest = self.pending\n        self.pending = ''\n        return [rest] if rest else []\n"
      },
      "check": "from lines import LineBuffer\nb=LineBuffer(); assert b.feed('a\\r')==[]; assert b.feed('\\n\\nb\\nc')==['a','','b']; assert b.feed('d')==[]; assert b.finish()==['cd']; assert b.finish()==[]\nb=LineBuffer(); assert b.feed('\\n\\n')==['','']; assert b.finish()==[]\nb=LineBuffer(); assert b.feed('x\\r')==[]; assert b.finish()==['x\\r']\n",
      "command": "python3 -m unittest -v",
